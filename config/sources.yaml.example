# QoB source configuration (Option 1 — flow-based counting).
# Deployment is SOURCE-BASED RTBH (S/RTBH via uRPF): attacker = flow source.

rtbh_direction: source        # source | destination  (we use source)
join_field: src_ip            # derived from rtbh_direction
window_seconds: 86400         # daily buckets to line up with the 7-day TTL

# BHR blocked-IP list (the authoritative join key).
blocklist:
  # Either a live endpoint (Phase 2) or a captured snapshot (Phase 1).
  source: publist_csv         # publist_csv | query_limited | file
  url: https://bhr.example.edu/bhr/publist.csv
  # token: ${BHR_TOKEN}       # only needed for authenticated query endpoints

# Flow exporters on the RTBH-handling routers. Sampling is accepted for v1;
# record the rate so counts can be scaled.
flow_exporters:
  - device: rtr1
    kind: ipfix              # ipfix | netflow9 | sflow
    sampling_rate: 1000      # 1 == unsampled
  - device: rtr2
    kind: ipfix
    sampling_rate: 1000

collector:
  kind: goflow2             # goflow2 | nfdump  (chosen: goflow2, plan §3.1)
  flow_file: /var/log/goflow2/flows.json   # JSON the consumer tails

# Chosen store: aggregate-at-ingest into Redis with a per-key TTL (plan §3.1).
# Keeps the flow firehose off the Elasticsearch cluster; counts auto-expire.
store:
  kind: redis               # redis | es  (es path retained as optional alt)
  host: redis
  port: 6379
  prefix: qob
  ttl_days: 8               # 8 so a rolling 7-day sum always has a full 7th day
  persistence: aof          # enable AOF/RDB — counts are client-facing
